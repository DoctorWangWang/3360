#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// mouse move settings

#define MMV_U MOVE_VERT(-650)
#define MMV_D MOVE_VERT(650)
#define MMV_L MOVE_HOR(-650)
#define MMV_R MOVE_HOR(650)

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
};

// mouse wheel settings

#define MWH_U SCROLL_VERT(10)
#define MWH_D SCROLL_VERT(-10)
#define MWH_L SCROLL_HOR(-10)
#define MWH_R SCROLL_HOR(10)

&mwh {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <0>;
};

&lt {
    quick-tap-ms = <170>;
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define HOTKEY  3
#define MSE     4

#define AS(keycode) &as LS(keycode) keycode

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp TAB>;
        };
    };

    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        modcp: mod_copy {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_COPY";
            #binding-cells = <0>;
            bindings = <&as LS(C) C>, <&kp C>;

            mods = <(LGUI | RGUI)>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;

            quick-tap-ms = <200>;
            global-quick-tap;
            retro-tap;
        };

        td1: td1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            bindings = <&tog 1>, <&tog 3>;

            tapping-term-ms = <200>;
        };

        td2: td2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD2";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&lt 2 SPACE>, <&kp SPACE>;
        };
    };

    macros {
        macro_email_g: macro_email_g {
            // 135115

            compatible = "zmk,behavior-macro";
            label = "MACRO_EMAIL_GMAIL";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N3 &kp N5 &kp N1 &kp N1 &kp N5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_left {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&mkp LCLK>;
        };

        combo_right {
            timeout-ms = <50>;
            key-positions = <36 37>;
            bindings = < &mkp MCLK >;
        };

        combo_LSHFT {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mkp RCLK>;
        };

        combo_LSH {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LSHFT>;
        };

        combo_LGUI {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp LGUI>;
        };

        combo_GU {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&tog 1>;
        };

        combo_GUI {
            timeout-ms = <50>;
            key-positions = <>;
            bindings = < &kp TAB >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
&kp ESC               &as LS(Q) Q  &as LS(W) W   &as LS(E) E          &as LS(R) R    &as LS(T) T   &as LS(Y) Y  &as LS(U) U  &as LS(I) I          &as LS(O) O        &as LS(P) P        &mt LEFT_SHIFT EQUAL
&mt LEFT_SHIFT ENTER  &as LS(A) A  &as LS(S) S   &as LS(D) D          &as LS(F) F    &as LS(G) G   &as LS(H) H  &as LS(J) J  &as LS(K) K          &as LS(L) L        &as LS(SEMI) SEMI  &as LS(SQT) SQT
&kp CAPS              &as LS(Z) Z  &as LS(X) X   &as LS(C) C          &as LS(V) V    &as LS(B) B   &as LS(N) N  &as LS(M) M  &as LS(COMMA) COMMA  &as LS(DOT) DOT    &as LS(FSLH) FSLH  &as LS(BSLH) BSLH
                                   &kp LC(C)     &kp LC(V)            &lt 1 BSPC     &lt 2 SPACE   &kp LEFT     &kp RIGHT    &as LS(LBKT) LBKT    &as LS(RBKT) RBKT
                                   &kp LEFT_ALT  &as LS(GRAVE) GRAVE  &mt LCTRL TAB  &lt 3 DELETE  &none        &none        &mo 3                &mo 3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp RIGHT LEFT>;
            trackball-bindings = <&tmv>;
        };

        number_layer {
            label = "NUMBER";
            bindings = <
&kp ESC   &kp STAR   &kp N7     &kp N8     &kp N9    &kp BSPC    &kp LS(LPAR)  &kp LS(RPAR)  &kp BSPC      &kp EQUAL     &kp EQUAL  &kp EQUAL
&kp BSPC  &kp MINUS  &kp N4     &kp N5     &kp N6    &kp PERIOD  &kp LBKT      &kp RBKT      &kp LEFT      &kp RIGHT     &kp SEMI   &kp SEMI
&kp FSLH  &kp PLUS   &kp N1     &kp N2     &kp N3    &kp N0      &kp LS(LBRC)  &kp LS(RBRC)  &kp UP        &kp DOWN      &kp SEMI   &kp SEMI
                     &kp LC(C)  &kp LC(V)  &kp BSPC  &kp SPACE   &kp LEFT      &kp RIGHT     &kp LS(EXCL)  &kp LS(EXCL)
                     &trans     &none      &tog 1    &kp TAB     &kp N2        &kp N2        &tog 1        &tog 1
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;

            trackball-bindings = <&tsl>;
        };

        symbol_layer {
            label = "SYMBOL";
            bindings = <
&kp LS(TILDE)  &kp STAR   &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp LS(LPAR)  &kp LS(RPAR)  &kp UP    &kp EQUAL  &kp EQUAL  &kp EQUAL
&kp BSPC       &kp MINUS  &kp DLLR   &kp PRCNT  &kp CARET  &kp UNDER  &kp BSPC      &kp LEFT      &kp DOWN  &kp RIGHT  &kp SEMI   &none
&kp FSLH       &kp PLUS   &kp EXCL   &kp AT     &kp HASH   &kp EQUAL  &kp BSPC      &kp DOWN      &kp DOWN  &kp DOWN   &kp SEMI   &none
                          &kp LC(C)  &kp LC(V)  &kp BSPC   &kp SPACE  &kp SPACE     &kp SPACE     &none     &none
                          &none      &none      &kp LSHFT  &none      &none         &none         &none     &none
            >;

            trackball-bindings = <&tmv_fine>;
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        hotkey_layer {
            label = "HOTKEY";
            bindings = <
&kp ESC  &kp N3       &kp F7  &kp F8  &kp F9  &kp F10  &bt BT_CLR    &kp N3  &kp N3       &kp N3  &bt BT_SEL 0  &bt BT_SEL 0
&kp ESC  &reset       &kp F4  &kp F5  &kp F6  &kp F11  &out OUT_USB  &none   &reset       &none   &none         &none
&kp ESC  &bootloader  &kp F1  &kp F2  &kp F3  &kp F12  &out OUT_BLE  &none   &bootloader  &none   &none         &none
                      &none   &none   &none   &none    &none         &none   &none        &none
                      &none   &none   &none   &none    &none         &none   &mo 3        &mo 3
            >;

            trackball-bindings = <&tmv_x>;
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp UP DOWN>;
        };
    };
};
