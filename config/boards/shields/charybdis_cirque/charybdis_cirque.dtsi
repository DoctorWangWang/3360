#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zephyr,display = &oled;
        zmk,kscan = &kscan0;
        /* ZMK Studio 要求使用 physical layout（不能再只用 zmk,matrix_transform chosen）。 */
        zmk,physical-layout = &physical_layout0;
    };

    /*
     * 物理布局：ZMK Studio 用它渲染按键预览，并把改键结果映射回矩阵。
     * keys 单位 1/100 u，顺序必须与 default_transform 的 map 顺序一致（共 52 键）。
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Charybdis 3360";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys  //                     w   h    x    y   rot   rx   ry
            = <&key_physical_attrs 100 100    0    0       0     0     0>
            , <&key_physical_attrs 100 100  100    0       0     0     0>
            , <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400    0       0     0     0>
            , <&key_physical_attrs 100 100  500    0       0     0     0>
            , <&key_physical_attrs 100 100 1250    0       0     0     0>
            , <&key_physical_attrs 100 100 1350    0       0     0     0>
            , <&key_physical_attrs 100 100 1450    0       0     0     0>
            , <&key_physical_attrs 100 100 1550    0       0     0     0>
            , <&key_physical_attrs 100 100 1650    0       0     0     0>
            , <&key_physical_attrs 100 100 1750    0       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  100  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  100       0     0     0>
            , <&key_physical_attrs 100 100  500  100       0     0     0>
            , <&key_physical_attrs 100 100 1250  100       0     0     0>
            , <&key_physical_attrs 100 100 1350  100       0     0     0>
            , <&key_physical_attrs 100 100 1450  100       0     0     0>
            , <&key_physical_attrs 100 100 1550  100       0     0     0>
            , <&key_physical_attrs 100 100 1650  100       0     0     0>
            , <&key_physical_attrs 100 100 1750  100       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  100  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
            , <&key_physical_attrs 100 100  400  200       0     0     0>
            , <&key_physical_attrs 100 100  500  200       0     0     0>
            , <&key_physical_attrs 100 100 1250  200       0     0     0>
            , <&key_physical_attrs 100 100 1350  200       0     0     0>
            , <&key_physical_attrs 100 100 1450  200       0     0     0>
            , <&key_physical_attrs 100 100 1550  200       0     0     0>
            , <&key_physical_attrs 100 100 1650  200       0     0     0>
            , <&key_physical_attrs 100 100 1750  200       0     0     0>
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 175  550  375    3000   600   325>
            , <&key_physical_attrs 100 175  675  325    3000   600   325>
            , <&key_physical_attrs 100 175 1075  325 (-3000)  1250   325>
            , <&key_physical_attrs 100 175 1200  375 (-3000)  1250   325>
            , <&key_physical_attrs 100 100 1450  300       0     0     0>
            , <&key_physical_attrs 100 100 1550  300       0     0     0>
            , <&key_physical_attrs 100 100  700  675    3000   600   325>
            , <&key_physical_attrs 100 100  825  650    3000   600   325>
            , <&key_physical_attrs 100 100  700  550    3000   600   325>
            , <&key_physical_attrs 100 100  825  525    3000   600   325>
            , <&key_physical_attrs 100 100  925  525 (-3000)  1250   325>
            , <&key_physical_attrs 100 100 1050  550 (-3000)  1250   325>
            , <&key_physical_attrs 100 100  925  650 (-3000)  1250   325>
            , <&key_physical_attrs 100 100 1050  675 (-3000)  1250   325>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6)  RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6)  RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6)  RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                RC(3,2) RC(3,3) RC(3,4) RC(3,5)  RC(3,6)  RC(3,7) RC(3,8) RC(3,9)
                RC(4,2) RC(4,3) RC(4,4) RC(4,5)  RC(4,6)  RC(4,7) RC(4,8) RC(4,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /* encoders */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        status = "disabled";
        a-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        /* steps = 每圈脉冲数，与 triggers-per-rotation 保持 2:1（40 : 20） */
        steps = <40>;
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        status = "disabled";
        a-gpios = <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        steps = <40>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        /* 一圈 20 格；与 steps=<40> 组成 2:1，每 2 个脉冲算 1 步 */
        triggers-per-rotation = <20>;
    };

    /*
     * 轨迹球 input-listener：把 PMW3360 传感器的 input 事件（INPUT_REL_X/Y）
     * 接入 ZMK 输入子系统，经默认 pointing 输出映射为鼠标移动。
     */
    trackball_listener {
        compatible = "zmk,input-listener";
        status = "okay";
        device = <&trackball>;
    };
};

/*
 * PMW3360 轨迹球走 SPI（ZMK v0.3 / Zephyr 3.5 里 nice!nano 的 pro_micro_spi = &spi1）。
 * 3360 接线（与 test 分支旧 fork 一致）：SCK=P0.31 / MOSI=P0.20 / MISO=P0.17，
 * CS=P0.29，IRQ=P0.08。这里覆盖 spi1 的 pinctrl 到硬件实际引脚。
 */
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
                <NRF_PSEL(SPIM_MOSI, 0, 20)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 31)>,
                <NRF_PSEL(SPIM_MOSI, 0, 20)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                <NRF_PSEL(TWIM_SCL, 1, 7)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 1, 2)>,
                <NRF_PSEL(TWIM_SCL, 1, 7)>;
            low-power-enable;
        };
    };
};

&pro_micro_spi {
    compatible = "nordic,nrf-spim";
    status = "disabled";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        compatible = "pixart,pmw3360";
        status = "disabled";
        reg = <0>;
        irq-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        spi-max-frequency = <2000000>;
        /* 在第 2 层（SYMBOL 层）时轨迹球移动转为滚轮（对应旧 fork 的 scroll-layer=<2>） */
        scroll-layers = <2>;
    };
};

&pro_micro_i2c {
    compatible = "nordic,nrf-twi";
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        label = "DISPLAY";
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
    };
};
